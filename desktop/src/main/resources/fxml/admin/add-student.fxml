<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.AddStudentController"
      spacing="22.0"
      prefWidth="520.0"
      prefHeight="500.0"
      styleClass="form-dialog">

    <!-- Header -->
    <VBox spacing="5.0">

        <Label text="Add Student"
               styleClass="dialog-title"/>

        <Label text="Create a new student record"
               styleClass="dialog-subtitle"/>

    </VBox>

    <!-- Form Fields -->
    <VBox spacing="17.0">

        <VBox spacing="7.0">

            <Label text="Student Name"
                   styleClass="form-label"/>

            <TextField fx:id="nameField"
                       promptText="Enter student name"
                       styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Admission Number"
                   styleClass="form-label"/>

            <TextField fx:id="admissionNumberField"
                       promptText="e.g. STU005"
                       styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Class"
                   styleClass="form-label"/>

            <ComboBox fx:id="classComboBox"
                      maxWidth="Infinity"
                      promptText="Select class"
                      styleClass="form-input"/>

        </VBox>

    </VBox>

    <!-- Push buttons to bottom -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- Actions -->
    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>

        <Button text="Create Student"
                onAction="#handleCreateStudent"
                styleClass="primary-button"/>

    </HBox>

</VBox>