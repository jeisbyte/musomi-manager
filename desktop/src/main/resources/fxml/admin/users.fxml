<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.UsersController"
      spacing="20.0"
      styleClass="content-area">

    <!-- PAGE HEADER -->
    <VBox spacing="5.0">

        <Label text="Users"
               styleClass="page-title"/>

        <Label text="Manage system users"
               styleClass="page-subtitle"/>

    </VBox>


    <!-- SEARCH + ADD USERS -->
    <HBox spacing="15.0">
        <TextField promptText="Search users..."
                   prefWidth="350.0"/>

        <Button text="+ Add User"
                onAction="#showAddUserDialog"
                styleClass="primary-button"/>
    </HBox>


    <!-- USERS TABLE -->
    <TableView VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn text="Name"
                         prefWidth="220.0"/>

            <TableColumn text="Username"
                         prefWidth="180.0"/>

            <TableColumn text="Role"
                         prefWidth="150.0"/>

            <TableColumn text="Status"
                         prefWidth="120.0"/>

            <TableColumn text="Actions"
                         prefWidth="180.0"/>

        </columns>

    </TableView>

</VBox>