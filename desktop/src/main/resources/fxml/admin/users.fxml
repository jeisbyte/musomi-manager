<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.UsersController"
      spacing="20.0"
      styleClass="page-container">

    <!-- PAGE HEADER -->
    <VBox spacing="5.0">

        <Label text="Users"
               styleClass="page-title"/>

        <Label text="Manage system users"
               styleClass="page-subtitle"/>

    </VBox>


    <!-- TOOLBAR -->
    <HBox spacing="12.0"
          alignment="CENTER_LEFT">

        <TextField fx:id="searchField"
                   promptText="Search users..."
                   prefWidth="360.0"
                   styleClass="page-search-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+  Add User"
                onAction="#showAddUserDialog"
                styleClass="primary-button"/>

    </HBox>


    <!-- TABLE CARD -->
    <VBox VBox.vgrow="ALWAYS"
          styleClass="table-card">

        <TableView fx:id="usersTable"
                   VBox.vgrow="ALWAYS"
                   styleClass="modern-table">

            <columns>

                <TableColumn fx:id="nameColumn"
                             text="Name"
                             prefWidth="220.0"/>

                <TableColumn fx:id="usernameColumn"
                             text="Username"
                             prefWidth="180.0"/>

                <TableColumn fx:id="roleColumn"
                             text="Role"
                             prefWidth="150.0"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="120.0"/>

                <TableColumn fx:id="actionsColumn"
                             text="Actions"
                             prefWidth="200.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>