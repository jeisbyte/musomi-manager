<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.ClassesController"
      spacing="20.0"
      styleClass="content-area">

    <!-- PAGE HEADER -->

    <VBox spacing="5.0">

        <Label text="Classes"
               styleClass="page-title"/>

        <Label text="Manage school classes"
               styleClass="page-subtitle"/>

    </VBox>


    <!-- SEARCH + ADD CLASS -->

    <HBox spacing="15.0">

        <TextField fx:id="searchField"
                   promptText="Search classes..."
                   prefWidth="350.0"/>

        <Button text="+ Add Class"
                onAction="#showAddClassDialog"
                styleClass="primary-button"/>

    </HBox>


    <!-- CLASSES TABLE -->

    <TableView fx:id="classesTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Class"
                         prefWidth="220.0"/>

            <TableColumn fx:id="levelColumn"
                         text="Level"
                         prefWidth="180.0"/>

            <TableColumn fx:id="studentsColumn"
                         text="Students"
                         prefWidth="150.0"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="120.0"/>

            <TableColumn fx:id="actionsColumn"
                         text="Actions"
                         prefWidth="180.0"/>

        </columns>

    </TableView>

</VBox>