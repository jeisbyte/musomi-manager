<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.EditUserController"
      spacing="15.0"
      prefWidth="500.0"
      prefHeight="500.0"
      styleClass="dialog-container">

    <Label text="Edit User"
           styleClass="page-title"/>

    <Label text="Update user information"
           styleClass="page-subtitle"/>

    <VBox spacing="6.0">
        <Label text="Full Name"/>
        <TextField fx:id="fullNameField"
                   promptText="Enter full name"/>
    </VBox>

    <VBox spacing="6.0">
        <Label text="Username"/>
        <TextField fx:id="usernameField"
                   promptText="Enter username"/>
    </VBox>

    <VBox spacing="6.0">
        <Label text="Role"/>

        <ComboBox fx:id="roleComboBox"
                  maxWidth="Infinity"
                  promptText="Select role"/>
    </VBox>

    <VBox spacing="6.0">
        <Label text="Status"/>

        <ComboBox fx:id="statusComboBox"
                  maxWidth="Infinity"
                  promptText="Select status"/>
    </VBox>

    <HBox spacing="10.0">

        <Button text="Cancel"
                onAction="#handleCancel"/>

        <Button text="Save Changes"
                onAction="#handleSave"
                styleClass="primary-button"/>

    </HBox>

</VBox>