<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.AddClassController"
      spacing="22.0"
      prefWidth="520.0"
      prefHeight="430.0"
      styleClass="form-dialog">

    <!-- HEADER -->

    <VBox spacing="5.0">

        <Label text="Add Class"
               styleClass="dialog-title"/>

        <Label text="Create a new school class"
               styleClass="dialog-subtitle"/>

    </VBox>


    <!-- FORM -->

    <VBox spacing="17.0">

        <!-- CLASS NAME -->

        <VBox spacing="7.0">

            <Label text="Class Name"
                   styleClass="form-label"/>

            <TextField fx:id="nameField"
                       promptText="e.g. Senior One"
                       styleClass="form-input"/>

        </VBox>


        <!-- LEVEL -->

        <VBox spacing="7.0">

            <Label text="Level"
                   styleClass="form-label"/>

            <ComboBox fx:id="levelComboBox"
                      maxWidth="Infinity"
                      promptText="Select level"
                      styleClass="form-input"/>

        </VBox>

    </VBox>


    <Region VBox.vgrow="ALWAYS"/>


    <!-- BUTTONS -->

    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>

        <Button text="Create Class"
                onAction="#handleCreateClass"
                styleClass="primary-button"/>

    </HBox>

</VBox>