<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.AddSubjectController"
      spacing="22.0"
      prefWidth="520.0"
      prefHeight="430.0"
      styleClass="form-dialog">

    <!-- Header -->
    <VBox spacing="5.0">

        <Label text="Add Subject"
               styleClass="dialog-title"/>

        <Label text="Create a new school subject"
               styleClass="dialog-subtitle"/>

    </VBox>

    <!-- Form Fields -->
    <VBox spacing="17.0">

        <VBox spacing="7.0">

            <Label text="Subject Name"
                   styleClass="form-label"/>

            <TextField fx:id="nameField"
                       promptText="e.g. Mathematics"
                       styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Subject Code"
                   styleClass="form-label"/>

            <TextField fx:id="codeField"
                       promptText="e.g. MATH"
                       styleClass="form-input"/>

        </VBox>

    </VBox>

    <!-- Push buttons to bottom -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- Actions -->
    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>

        <Button text="Create Subject"
                onAction="#handleCreateSubject"
                styleClass="primary-button"/>

    </HBox>

</VBox>