<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.EditSubjectController"
      spacing="15.0"
      prefWidth="500.0"
      prefHeight="450.0"
      styleClass="dialog-container">

    <Label text="Edit Subject"
           styleClass="page-title"/>

    <Label text="Update subject information"
           styleClass="page-subtitle"/>

    <VBox spacing="6.0">
        <Label text="Subject Name"/>

        <TextField fx:id="nameField"
                   promptText="Enter subject name"/>
    </VBox>

    <VBox spacing="6.0">
        <Label text="Subject Code"/>

        <TextField fx:id="codeField"
                   promptText="Enter subject code"/>
    </VBox>

    <VBox spacing="6.0">
        <Label text="Status"/>

        <ComboBox fx:id="statusComboBox"
                  maxWidth="Infinity"
                  promptText="Select status"/>
    </VBox>

    <HBox spacing="10.0">

        <Button text="Cancel"
                onAction="#handleCancel"/>

        <Button text="Save Changes"
                onAction="#handleSave"
                styleClass="primary-button"/>

    </HBox>

</VBox>