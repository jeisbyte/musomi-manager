<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.TopicsController"
      spacing="20.0"
      styleClass="page-container">

    <VBox spacing="5.0">
        <Label text="Topics"
               styleClass="page-title"/>

        <Label text="Manage subject topics"
               styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="12.0"
          alignment="CENTER_LEFT">

        <TextField fx:id="searchField"
                   promptText="Search topics..."
                   prefWidth="360.0"
                   styleClass="page-search-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+  Add Topic"
                onAction="#showAddTopicDialog"
                styleClass="primary-button"/>

    </HBox>

    <VBox VBox.vgrow="ALWAYS"
          styleClass="table-card">

        <TableView fx:id="topicsTable"
                   VBox.vgrow="ALWAYS"
                   styleClass="modern-table">

            <columns>

                <TableColumn fx:id="nameColumn"
                             text="Topic"
                             prefWidth="280.0"/>

                <TableColumn fx:id="subjectColumn"
                             text="Subject"
                             prefWidth="240.0"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="160.0"/>

                <TableColumn fx:id="actionsColumn"
                             text="Actions"
                             prefWidth="220.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>