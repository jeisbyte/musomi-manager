<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.TopicsController"
      spacing="20.0"
      styleClass="content-area">

    <VBox spacing="5.0">

        <Label text="Topics"
               styleClass="page-title"/>

        <Label text="Manage subject topics"
               styleClass="page-subtitle"/>

    </VBox>

    <HBox spacing="15.0">

        <TextField fx:id="searchField"
                   promptText="Search topics..."
                   prefWidth="350.0"/>

        <Button text="+ Add Topic"
                onAction="#showAddTopicDialog"
                styleClass="primary-button"/>

    </HBox>

    <TableView fx:id="topicsTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Topic"
                         prefWidth="300.0"/>

            <TableColumn fx:id="subjectColumn"
                         text="Subject"
                         prefWidth="220.0"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="150.0"/>

            <TableColumn fx:id="actionsColumn"
                         text="Actions"
                         prefWidth="200.0"/>

        </columns>

    </TableView>

</VBox>