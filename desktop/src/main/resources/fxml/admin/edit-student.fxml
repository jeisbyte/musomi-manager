<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.EditStudentController"
      spacing="22.0"
      prefWidth="520.0"
      prefHeight="600.0"
      styleClass="form-dialog">

    <VBox spacing="5.0">

        <Label text="Edit Student"
               styleClass="dialog-title"/>

        <Label text="Update student information"
               styleClass="dialog-subtitle"/>

    </VBox>

    <VBox spacing="17.0">

        <VBox spacing="7.0">

            <Label text="Student Name"
                   styleClass="form-label"/>

            <TextField fx:id="nameField"
                       promptText="Enter student name"
                       styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Admission Number"
                   styleClass="form-label"/>

            <TextField fx:id="admissionNumberField"
                       promptText="Enter admission number"
                       styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Class"
                   styleClass="form-label"/>

            <ComboBox fx:id="classComboBox"
                      maxWidth="Infinity"
                      promptText="Select class"
                      styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Status"
                   styleClass="form-label"/>

            <ComboBox fx:id="statusComboBox"
                      maxWidth="Infinity"
                      promptText="Select status"
                      styleClass="form-input"/>

        </VBox>

    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>

        <Button text="Save Changes"
                onAction="#handleSave"
                styleClass="primary-button"/>

    </HBox>

</VBox>