<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.SettingsController"
      spacing="20.0"
      styleClass="content-area">

    <VBox spacing="5.0">

        <Label text="Settings"
               styleClass="page-title"/>

        <Label text="Manage system settings"
               styleClass="page-subtitle"/>

    </VBox>

    <VBox spacing="20.0"
          styleClass="dashboard-card">

        <Label text="School Information"
               styleClass="section-title"/>

        <VBox spacing="6.0">

            <Label text="School Name"/>

            <TextField fx:id="schoolNameField"
                       promptText="Enter school name"/>

        </VBox>

        <VBox spacing="6.0">

            <Label text="Academic Year"/>

            <TextField fx:id="academicYearField"
                       promptText="e.g. 2026"/>

        </VBox>

        <VBox spacing="6.0">

            <Label text="Current Term"/>

            <ComboBox fx:id="termComboBox"
                      maxWidth="Infinity"
                      promptText="Select current term"/>

        </VBox>

        <HBox spacing="10.0">

            <Button text="Save Settings"
                    onAction="#handleSave"
                    styleClass="primary-button"/>

        </HBox>

    </VBox>

</VBox>