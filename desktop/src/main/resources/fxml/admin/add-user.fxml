<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.AddUserController"
      spacing="22.0"
      prefWidth="520.0"
      prefHeight="590.0"
      styleClass="form-dialog">

    <!-- HEADER -->

    <VBox spacing="5.0">

        <Label text="Add User"
               styleClass="dialog-title"/>

        <Label text="Create a new system user"
               styleClass="dialog-subtitle"/>

    </VBox>


    <!-- FORM -->

    <VBox spacing="17.0">

        <!-- FULL NAME -->

        <VBox spacing="7.0">

            <Label text="Full Name"
                   styleClass="form-label"/>

            <TextField fx:id="fullNameField"
                       promptText="Enter full name"
                       styleClass="form-input"/>

        </VBox>


        <!-- USERNAME -->

        <VBox spacing="7.0">

            <Label text="Username"
                   styleClass="form-label"/>

            <TextField fx:id="usernameField"
                       promptText="Enter username"
                       styleClass="form-input"/>

        </VBox>


        <!-- PASSWORD -->

        <VBox spacing="7.0">

            <Label text="Password"
                   styleClass="form-label"/>

            <PasswordField fx:id="passwordField"
                           promptText="Enter password"
                           styleClass="form-input"/>

        </VBox>


        <!-- ROLE -->

        <VBox spacing="7.0">

            <Label text="Role"
                   styleClass="form-label"/>

            <ComboBox fx:id="roleComboBox"
                      promptText="Select role"
                      maxWidth="Infinity"
                      styleClass="form-input"/>

        </VBox>

    </VBox>


    <Region VBox.vgrow="ALWAYS"/>


    <!-- BUTTONS -->

    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>

        <Button text="Create User"
                onAction="#handleCreateUser"
                styleClass="primary-button"/>

    </HBox>

</VBox>