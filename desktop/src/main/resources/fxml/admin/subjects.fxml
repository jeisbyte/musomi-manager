<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.SubjectsController"
      spacing="20.0"
      styleClass="content-area">

    <VBox spacing="5.0">
        <Label text="Subjects"
               styleClass="page-title"/>

        <Label text="Manage school subjects"
               styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="15.0">

        <TextField fx:id="searchField"
                   promptText="Search subjects..."
                   prefWidth="350.0"/>

        <Button text="+ Add Subject"
                onAction="#showAddSubjectDialog"
                styleClass="primary-button"/>

    </HBox>

    <TableView fx:id="subjectsTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Subject"
                         prefWidth="250.0"/>

            <TableColumn fx:id="codeColumn"
                         text="Code"
                         prefWidth="180.0"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="150.0"/>

            <TableColumn fx:id="actionsColumn"
                         text="Actions"
                         prefWidth="200.0"/>

        </columns>

    </TableView>

</VBox>