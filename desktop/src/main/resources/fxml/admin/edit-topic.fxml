<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.EditTopicController"
      spacing="22.0"
      prefWidth="520.0"
      prefHeight="520.0"
      styleClass="form-dialog">

    <!-- Header -->
    <VBox spacing="5.0">

        <Label text="Edit Topic"
               styleClass="dialog-title"/>

        <Label text="Update topic information"
               styleClass="dialog-subtitle"/>

    </VBox>

    <!-- Form Fields -->
    <VBox spacing="17.0">

        <VBox spacing="7.0">

            <Label text="Topic Name"
                   styleClass="form-label"/>

            <TextField fx:id="nameField"
                       promptText="Enter topic name"
                       styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Subject"
                   styleClass="form-label"/>

            <ComboBox fx:id="subjectComboBox"
                      maxWidth="Infinity"
                      promptText="Select subject"
                      styleClass="form-input"/>

        </VBox>

        <VBox spacing="7.0">

            <Label text="Status"
                   styleClass="form-label"/>

            <ComboBox fx:id="statusComboBox"
                      maxWidth="Infinity"
                      promptText="Select status"
                      styleClass="form-input"/>

        </VBox>

    </VBox>

    <!-- Push buttons to bottom -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- Actions -->
    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>

        <Button text="Save Changes"
                onAction="#handleSave"
                styleClass="primary-button"/>

    </HBox>

</VBox>