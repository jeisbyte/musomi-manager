<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.StudentsController"
      spacing="20.0"
      styleClass="content-area">

    <VBox spacing="5.0">

        <Label text="Students"
               styleClass="page-title"/>

        <Label text="Manage school students"
               styleClass="page-subtitle"/>

    </VBox>

    <HBox spacing="15.0">

        <TextField fx:id="searchField"
                   promptText="Search students..."
                   prefWidth="350.0"/>

        <Button text="+ Add Student"
                onAction="#showAddStudentDialog"
                styleClass="primary-button"/>

    </HBox>

    <TableView fx:id="studentsTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Student Name"
                         prefWidth="250.0"/>

            <TableColumn fx:id="admissionNumberColumn"
                         text="Admission No."
                         prefWidth="180.0"/>

            <TableColumn fx:id="classColumn"
                         text="Class"
                         prefWidth="180.0"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="150.0"/>

            <TableColumn fx:id="actionsColumn"
                         text="Actions"
                         prefWidth="200.0"/>

        </columns>

    </TableView>

</VBox>