<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.AuditLogController"
      spacing="20.0"
      styleClass="page-container">

    <!-- Page Header -->
    <VBox spacing="5.0">

        <Label text="Audit Log"
               styleClass="page-title"/>

        <Label text="View system activity and changes"
               styleClass="page-subtitle"/>

    </VBox>

    <!-- Toolbar -->
    <HBox spacing="12.0"
          alignment="CENTER_LEFT">

        <TextField fx:id="searchField"
                   promptText="Search audit log..."
                   prefWidth="360.0"
                   styleClass="page-search-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="System activity"
               styleClass="section-link"/>

    </HBox>

    <!-- Audit Table -->
    <VBox VBox.vgrow="ALWAYS"
          spacing="12.0"
          styleClass="table-card">

        <HBox alignment="CENTER_LEFT">

            <Label text="Activity History"
                   styleClass="section-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Recent system actions"
                   styleClass="dialog-subtitle"/>

        </HBox>

        <TableView fx:id="auditTable"
                   VBox.vgrow="ALWAYS"
                   styleClass="modern-table">

            <columns>

                <TableColumn fx:id="dateColumn"
                             text="Date &amp; Time"
                             prefWidth="180.0"/>

                <TableColumn fx:id="userColumn"
                             text="User"
                             prefWidth="160.0"/>

                <TableColumn fx:id="actionColumn"
                             text="Action"
                             prefWidth="140.0"/>

                <TableColumn fx:id="moduleColumn"
                             text="Module"
                             prefWidth="140.0"/>

                <TableColumn fx:id="descriptionColumn"
                             text="Description"
                             prefWidth="400.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>