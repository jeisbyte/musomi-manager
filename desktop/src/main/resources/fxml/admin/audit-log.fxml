<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.admin.AuditLogController"
      spacing="20.0"
      styleClass="content-area">

    <VBox spacing="5.0">

        <Label text="Audit Log"
               styleClass="page-title"/>

        <Label text="View system activity and changes"
               styleClass="page-subtitle"/>

    </VBox>

    <HBox spacing="15.0">

        <TextField fx:id="searchField"
                   promptText="Search audit log..."
                   prefWidth="350.0"/>

    </HBox>

    <TableView fx:id="auditTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="dateColumn"
                         text="Date &amp; Time"
                         prefWidth="180.0"/>

            <TableColumn fx:id="userColumn"
                         text="User"
                         prefWidth="180.0"/>

            <TableColumn fx:id="actionColumn"
                         text="Action"
                         prefWidth="150.0"/>

            <TableColumn fx:id="moduleColumn"
                         text="Module"
                         prefWidth="150.0"/>

            <TableColumn fx:id="descriptionColumn"
                         text="Description"
                         prefWidth="350.0"/>

        </columns>

    </TableView>

</VBox>