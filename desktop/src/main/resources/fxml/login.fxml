<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.LoginController"
      prefWidth="1280.0"
      prefHeight="720.0">

    <!-- LEFT: BRAND PANEL -->
    <VBox fx:id="leftPanel"
          styleClass="login-left-panel"
          HBox.hgrow="ALWAYS">

        <VBox spacing="0.0"
              styleClass="login-brand">

            <HBox spacing="12.0"
                  alignment="CENTER_LEFT">

                <Label text="MM"
                       styleClass="login-logo-mark"/>

                <VBox spacing="0.0">

                    <Label text="Musomi"
                           styleClass="login-brand-name"/>

                    <Label text="Manager"
                           styleClass="login-brand-subtitle"/>

                </VBox>

            </HBox>

            <Label fx:id="schoolNameLabel"
                   styleClass="login-school-name"
                   wrapText="true"/>

        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox spacing="18.0"
              styleClass="login-hero">

            <Label text="Better Education Management"
                   styleClass="login-hero-title"
                   wrapText="true"/>

            <Label text="Track performance. Empower teachers. Support every student."
                   styleClass="login-hero-description"
                   wrapText="true"/>

        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="Learning Record System"
               styleClass="login-footer-text"/>

    </VBox>


    <!-- RIGHT: LOGIN PANEL -->
    <VBox fx:id="rightPanel"
          styleClass="login-right-panel"
          alignment="CENTER"
          HBox.hgrow="ALWAYS">

        <VBox spacing="28.0"
              styleClass="login-card">

            <!-- HEADER -->
            <VBox spacing="7.0">

                <Label text="Welcome back"
                       styleClass="login-title"/>

                <Label text="Sign in to your Musomi Manager account"
                       styleClass="login-subtitle"
                       wrapText="true"/>

            </VBox>


            <!-- FORM -->
            <VBox spacing="18.0">

                <VBox spacing="7.0">

                    <Label text="Username or Email"
                           styleClass="form-label"/>

                    <TextField fx:id="usernameField"
                               promptText="Enter your username or email"
                               styleClass="login-input"
                               onAction="#handleLogin"/>

                </VBox>


                <VBox spacing="7.0">

                    <Label text="Password"
                           styleClass="form-label"/>

                    <PasswordField fx:id="passwordField"
                                   promptText="Enter your password"
                                   styleClass="login-input"
                                   onAction="#handleLogin"/>

                </VBox>

            </VBox>


            <!-- ERROR -->
            <Label fx:id="errorLabel"
                   styleClass="error-label"
                   wrapText="true"
                   visible="false"
                   managed="false"/>


            <!-- LOGIN BUTTON -->
            <StackPane>

                <Button fx:id="loginButton"
                        text="Sign In"
                        styleClass="login-button"
                        maxWidth="Infinity"
                        defaultButton="true"
                        onAction="#handleLogin"/>

                <ProgressIndicator fx:id="spinner"
                                   maxWidth="22.0"
                                   maxHeight="22.0"
                                   visible="false"
                                   managed="false"/>

            </StackPane>


            <!-- VERSION -->
            <VBox spacing="6.0"
                  alignment="CENTER">

                <Region prefHeight="1.0"/>

                <Label fx:id="versionLabel"
                       styleClass="login-version"
                       maxWidth="Infinity"
                       alignment="CENTER"/>

            </VBox>

        </VBox>

    </VBox>

</HBox>