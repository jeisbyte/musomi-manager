<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musomi.desktop.controller.MainLayoutController"
            style="-fx-background-color: #f8fafc;">

    <!-- ===================================================== -->
    <!-- TOP BAR                                               -->
    <!-- ===================================================== -->

    <top>
        <HBox prefHeight="56.0"
              alignment="CENTER_LEFT"
              spacing="16"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">

            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <Label text="MUSOMI MANAGER"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2563eb;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Teacher"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #64748b;"/>

            <Label text="John"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;"/>

        </HBox>
    </top>


    <!-- ===================================================== -->
    <!-- LEFT SIDEBAR                                          -->
    <!-- ===================================================== -->

    <left>
        <VBox prefWidth="240.0"
              spacing="4"
              style="-fx-background-color: white;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 0 1 0 0;">

            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>


            <!-- ROLE -->
            <Label text="TEACHER"
                   style="-fx-font-size: 11px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #94a3b8;
                          -fx-padding: 0 0 12 8;"/>


            <!-- ================================================= -->
            <!-- TEACHER NAVIGATION                                -->
            <!-- ================================================= -->

            <VBox fx:id="teacherNavSection"
                  spacing="4">

                <!-- DASHBOARD -->
                <Button fx:id="dashboardButton"
                        text="Dashboard"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showDashboard"
                        style="-fx-background-color: #eef4ff;
                               -fx-background-radius: 8px;
                               -fx-text-fill: #2563eb;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 11px 14px;
                               -fx-cursor: hand;"/>


                <!-- MARK ENTRY -->
                <Button fx:id="markEntryButton"
                        text="Mark Entry"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showMarkEntry"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #475569;
                               -fx-font-size: 14px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 11px 14px;
                               -fx-cursor: hand;"/>


                <!-- MY CLASSES -->
                <Button fx:id="myClassesButton"
                        text="My Classes"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showMyClasses"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #475569;
                               -fx-font-size: 14px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 11px 14px;
                               -fx-cursor: hand;"/>


                <!-- ASSESSMENTS -->
                <Button fx:id="assessmentsButton"
                        text="Assessments"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showAssessments"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #475569;
                               -fx-font-size: 14px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 11px 14px;
                               -fx-cursor: hand;"/>


                <!-- REPORTS -->
                <Button text="Reports"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #475569;
                               -fx-font-size: 14px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 11px 14px;
                               -fx-cursor: hand;"/>


                <!-- SETTINGS -->
                <Button text="Settings"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #475569;
                               -fx-font-size: 14px;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 11px 14px;
                               -fx-cursor: hand;"/>

            </VBox>


            <Region VBox.vgrow="ALWAYS"/>


            <!-- ================================================= -->
            <!-- ADMIN NAVIGATION                                  -->
            <!-- Hidden while developing Teacher UI               -->
            <!-- ================================================= -->

            <VBox fx:id="adminNavSection"
                  visible="false"
                  managed="false"
                  spacing="4">

                <Label text="ADMIN"
                       style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #94a3b8;
                              -fx-padding: 0 0 8 8;"/>

                <Button text="Users"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showUsers"/>

                <Button text="Classes"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showClasses"/>

                <Button text="Subjects"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showSubjects"/>

                <Button text="Topics"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showTopics"/>

                <Button text="Students"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showStudents"/>

                <Button text="Settings"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showSettings"/>

                <Button text="Audit Log"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showAuditLog"/>

            </VBox>

        </VBox>
    </left>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT AREA                                     -->
    <!-- ===================================================== -->

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #f8fafc;
                           -fx-background: #f8fafc;
                           -fx-border-color: transparent;">

            <content>
                <StackPane fx:id="contentArea"
                           style="-fx-background-color: #f8fafc;">

                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                </StackPane>
            </content>

        </ScrollPane>
    </center>

</BorderPane>