<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.teacher.MyClassesController"
      spacing="20.0"
      styleClass="content-area">

    <!-- PAGE HEADER -->
    <VBox spacing="5.0">

        <Label text="My Classes"
               styleClass="page-title"/>

        <Label text="Classes you are currently assigned to teach"
               styleClass="page-subtitle"/>

    </VBox>


    <!-- TOOLBAR -->
    <HBox spacing="10.0">

        <Button fx:id="refreshButton"
                text="Refresh"
                styleClass="btn-secondary"
                onAction="#handleRefresh"/>

    </HBox>


    <!-- LOADING STATE -->
    <VBox fx:id="loadingPane"
          alignment="CENTER"
          spacing="16.0"
          prefHeight="300.0"
          visible="true">

        <ProgressIndicator fx:id="loadingSpinner"
                           prefWidth="48.0"
                           prefHeight="48.0"/>

        <Label text="Loading your classes..."
               styleClass="body-small"/>

    </VBox>


    <!-- EMPTY STATE -->
    <VBox fx:id="emptyPane"
          alignment="CENTER"
          spacing="12.0"
          prefHeight="300.0"
          visible="false">

        <Label text="No Classes Assigned"
               styleClass="h3"/>

        <Label text="You have not been assigned to any classes yet. Contact your administrator."
               styleClass="body-small"
               wrapText="true"/>

    </VBox>


    <!-- ERROR STATE -->
    <VBox fx:id="errorPane"
          alignment="CENTER"
          spacing="12.0"
          prefHeight="300.0"
          visible="false">

        <Label text="Failed to Load Classes"
               styleClass="h3"/>

        <Label fx:id="errorMessageLabel"
               text="An error occurred."
               styleClass="error-label"
               wrapText="true"/>

        <Button text="Try Again"
                styleClass="btn-secondary"
                onAction="#handleRefresh"/>

    </VBox>


    <!-- CLASSES TABLE -->
    <TableView fx:id="classesTable"
               VBox.vgrow="ALWAYS"
               visible="false">

        <columns>

            <TableColumn fx:id="classColumn"
                         text="Class"
                         prefWidth="160.0"/>

            <TableColumn fx:id="streamColumn"
                         text="Stream"
                         prefWidth="140.0"/>

            <TableColumn fx:id="subjectColumn"
                         text="Subject"
                         prefWidth="220.0"/>

            <TableColumn fx:id="studentsColumn"
                         text="Students"
                         prefWidth="110.0"/>

            <TableColumn fx:id="assessmentsColumn"
                         text="Assessments"
                         prefWidth="130.0"/>

            <TableColumn fx:id="draftsColumn"
                         text="Drafts"
                         prefWidth="100.0"/>

        </columns>

    </TableView>

</VBox>
