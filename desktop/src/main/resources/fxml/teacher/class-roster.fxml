<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.musomi.desktop.controller.teacher.ClassRosterController"
            style="-fx-background-color: #f7f8fc;">

    <!-- ===================================================== -->
    <!-- PAGE HEADER                                           -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="5.0">

            <padding>
                <Insets top="26.0" right="30.0" bottom="18.0" left="30.0"/>
            </padding>

            <!-- Back button + class name row -->
            <HBox spacing="12.0" alignment="CENTER_LEFT">

                <Button text="← Back to My Classes"
                        onAction="#handleBack"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #4F46E5;
                               -fx-font-size: 13px;
                               -fx-font-weight: 600;
                               -fx-padding: 4 0;
                               -fx-cursor: hand;"/>

            </HBox>

            <Label fx:id="classNameLabel"
                   text="Class Roster"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;"/>

            <Label fx:id="studentCountLabel"
                   text="0 students"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #64748b;"/>

        </VBox>

    </top>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT                                          -->
    <!-- ===================================================== -->

    <center>

        <VBox spacing="16.0">

            <padding>
                <Insets top="0.0" right="30.0" bottom="25.0" left="30.0"/>
            </padding>


            <!-- ============================================= -->
            <!-- SEARCH TOOLBAR                                -->
            <!-- ============================================= -->

            <HBox spacing="12.0" alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search student name or admission number..."
                           prefWidth="380.0"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 8px;
                                  -fx-border-color: #e2e8f0;
                                  -fx-border-radius: 8px;
                                  -fx-padding: 10px;"/>

                <Region HBox.hgrow="ALWAYS"/>

            </HBox>


            <!-- ============================================= -->
            <!-- STUDENT TABLE                                 -->
            <!-- ============================================= -->

            <TableView fx:id="rosterTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                              -fx-background-radius: 10px;">

                <columns>

                    <TableColumn fx:id="numberColumn"
                                 text="#"
                                 prefWidth="55.0"/>

                    <TableColumn fx:id="admNoColumn"
                                 text="Admission Number"
                                 prefWidth="180.0"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Student Name"
                                 prefWidth="250.0"/>

                    <TableColumn fx:id="genderColumn"
                                 text="Gender"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120.0"/>

                </columns>

            </TableView>


            <!-- ============================================= -->
            <!-- EMPTY STATE                                   -->
            <!-- ============================================= -->

            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="10.0"
                  prefHeight="200.0"
                  visible="false"
                  managed="false"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10px;">

                <padding>
                    <Insets top="40.0" bottom="40.0"/>
                </padding>

                <Label text="No students found"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: 600;
                              -fx-text-fill: #1e293b;"/>

                <Label text="Try a different name or admission number."
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #64748b;"/>

            </VBox>


            <!-- ============================================= -->
            <!-- STATUS BAR                                    -->
            <!-- ============================================= -->

            <Separator/>

        </VBox>

    </center>

</BorderPane>
