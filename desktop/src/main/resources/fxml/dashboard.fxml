<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.musomi.desktop.controller.DashboardController"
            prefWidth="1000.0"
            prefHeight="630.0"
            style="-fx-background-color: #f7f8fc;">

    <center>

        <VBox spacing="22.0">

            <padding>
                <Insets top="28.0"
                        right="30.0"
                        bottom="28.0"
                        left="30.0"/>
            </padding>

            <!-- ================================================= -->
            <!-- PAGE HEADER                                      -->
            <!-- ================================================= -->

            <VBox spacing="5.0">

                <Label text="Good morning, John!"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1e293b;"/>

                <Label text="Here's what's happening at your school today."
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #64748b;"/>

            </VBox>


            <!-- ================================================= -->
            <!-- SUMMARY CARDS                                    -->
            <!-- ================================================= -->

            <GridPane hgap="16.0"
                      vgap="16.0">

                <!-- MY CLASSES -->

                <VBox GridPane.columnIndex="0"
                      spacing="7.0"
                      prefHeight="120.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: #eef5ff;
                             -fx-background-radius: 12px;
                             -fx-padding: 18px;">

                    <Label text="MY CLASSES"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #64748b;"/>

                    <Label text="6"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>

                    <Label text="Classes assigned"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #64748b;"/>

                </VBox>


                <!-- TOTAL STUDENTS -->

                <VBox GridPane.columnIndex="1"
                      spacing="7.0"
                      prefHeight="120.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: #eefbf4;
                             -fx-background-radius: 12px;
                             -fx-padding: 18px;">

                    <Label text="TOTAL STUDENTS"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #64748b;"/>

                    <Label text="180"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>

                    <Label text="Across all classes"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #64748b;"/>

                </VBox>


                <!-- PENDING MARKS -->

                <VBox GridPane.columnIndex="2"
                      spacing="7.0"
                      prefHeight="120.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: #fff5e9;
                             -fx-background-radius: 12px;
                             -fx-padding: 18px;">

                    <Label text="PENDING MARKS"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #64748b;"/>

                    <Label fx:id="pendingMarksCount"
                           text="0"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>

                    <Label text="Need attention"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #64748b;"/>

                </VBox>


                <!-- PUBLISHED ASSESSMENTS -->

                <VBox GridPane.columnIndex="3"
                      spacing="7.0"
                      prefHeight="120.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: #f4efff;
                             -fx-background-radius: 12px;
                             -fx-padding: 18px;">

                    <Label text="PUBLISHED ASSESSMENTS"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #64748b;"/>

                    <Label text="8"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>

                    <Label text="This term"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #64748b;"/>

                </VBox>

                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                    <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                    <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                    <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                </columnConstraints>
            </GridPane>


            <!-- ================================================= -->
            <!-- MIDDLE SECTION                                   -->
            <!-- ================================================= -->

            <HBox spacing="18.0"
                  VBox.vgrow="ALWAYS">

                <!-- RECENT ACTIVITY -->

                <VBox spacing="12.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12px;
                             -fx-padding: 20px;">

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Recent Activity"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1e293b;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="View all"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #6366f1;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"/>

                    </HBox>

                    <Separator/>


                    <HBox spacing="12.0"
                          alignment="CENTER_LEFT">

                        <Label text="✓"
                               prefWidth="30.0"
                               alignment="CENTER"
                               style="-fx-background-color: #eef2ff;
                                      -fx-background-radius: 15px;
                                      -fx-text-fill: #6366f1;
                                      -fx-font-weight: bold;"/>

                        <VBox spacing="2.0">

                            <Label text="Mathematics - Test 2"
                                   style="-fx-font-weight: bold;
                                          -fx-text-fill: #334155;"/>

                            <Label text="S3 Blue • 48 marks entered"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #64748b;"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="2 hours ago"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #94a3b8;"/>

                    </HBox>


                    <HBox spacing="12.0"
                          alignment="CENTER_LEFT">

                        <Label text="✓"
                               prefWidth="30.0"
                               alignment="CENTER"
                               style="-fx-background-color: #eef2ff;
                                      -fx-background-radius: 15px;
                                      -fx-text-fill: #6366f1;
                                      -fx-font-weight: bold;"/>

                        <VBox spacing="2.0">

                            <Label text="English - Assignment"
                                   style="-fx-font-weight: bold;
                                          -fx-text-fill: #334155;"/>

                            <Label text="S4 Red • 32 marks entered"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #64748b;"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="4 hours ago"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #94a3b8;"/>

                    </HBox>


                    <HBox spacing="12.0"
                          alignment="CENTER_LEFT">

                        <Label text="✓"
                               prefWidth="30.0"
                               alignment="CENTER"
                               style="-fx-background-color: #ecfdf5;
                                      -fx-background-radius: 15px;
                                      -fx-text-fill: #10b981;
                                      -fx-font-weight: bold;"/>

                        <VBox spacing="2.0">

                            <Label text="Biology - Test 1"
                                   style="-fx-font-weight: bold;
                                          -fx-text-fill: #334155;"/>

                            <Label text="S3 Blue • Published"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #64748b;"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="6 hours ago"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #94a3b8;"/>

                    </HBox>


                    <HBox spacing="12.0"
                          alignment="CENTER_LEFT">

                        <Label text="○"
                               prefWidth="30.0"
                               alignment="CENTER"
                               style="-fx-background-color: #fff7ed;
                                      -fx-background-radius: 15px;
                                      -fx-text-fill: #f59e0b;
                                      -fx-font-weight: bold;"/>

                        <VBox spacing="2.0">

                            <Label text="Chemistry - Quiz"
                                   style="-fx-font-weight: bold;
                                          -fx-text-fill: #334155;"/>

                            <Label text="S4 Red • Draft"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #64748b;"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Yesterday"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #94a3b8;"/>

                    </HBox>

                </VBox>


                <!-- CLASS PERFORMANCE -->

                <VBox spacing="12.0"
                      prefWidth="330.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12px;
                             -fx-padding: 20px;">

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Class Performance"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1e293b;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="This Term ▾"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #64748b;"/>

                    </HBox>

                    <Separator/>


                    <Label text="S3 Blue        82%"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #475569;"/>

                    <ProgressBar progress="0.82"
                                 maxWidth="Infinity"
                                 prefHeight="7.0"/>


                    <Label text="S3 Red         76%"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #475569;"/>

                    <ProgressBar progress="0.76"
                                 maxWidth="Infinity"
                                 prefHeight="7.0"/>


                    <Label text="S4 Blue        71%"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #475569;"/>

                    <ProgressBar progress="0.71"
                                 maxWidth="Infinity"
                                 prefHeight="7.0"/>


                    <Label text="S4 Red         68%"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #475569;"/>

                    <ProgressBar progress="0.68"
                                 maxWidth="Infinity"
                                 prefHeight="7.0"/>


                    <Label text="S5             64%"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #475569;"/>

                    <ProgressBar progress="0.64"
                                 maxWidth="Infinity"
                                 prefHeight="7.0"/>

                </VBox>

            </HBox>


            <!-- ================================================= -->
            <!-- MARK ENTRY REMINDER                              -->
            <!-- ================================================= -->

            <HBox spacing="15.0"
                  alignment="CENTER_LEFT"
                  style="-fx-background-color: #f4efff;
                         -fx-background-radius: 12px;
                         -fx-padding: 16px 20px;">

                <Label text="!"
                       prefWidth="34.0"
                       prefHeight="34.0"
                       alignment="CENTER"
                       style="-fx-background-color: #e9d5ff;
                              -fx-background-radius: 17px;
                              -fx-text-fill: #7c3aed;
                              -fx-font-size: 16px;
                              -fx-font-weight: bold;"/>

                <VBox spacing="3.0">

                    <Label text="Mark Entry Reminder"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #4c1d95;"/>

                    <Label fx:id="pendingReminderText"
                           text="Loading pending assessments..."
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #6b21a8;"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="markEntryButton"
                        text="Go to Mark Entry"
                        onAction="#goToMarkEntry"
                        style="-fx-background-color: #6366f1;
                               -fx-background-radius: 8px;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10px 16px;
                               -fx-cursor: hand;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>
