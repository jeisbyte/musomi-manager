<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.DashboardController"
      spacing="24.0"
      styleClass="dashboard-container">

    <!--HEADER -->

    <VBox spacing="5.0">

        <Label text="Dashboard"
               styleClass="page-title"/>

        <Label text="Welcome back, Administrator"
               styleClass="page-subtitle"/>

    </VBox>


    <!--STATISTIC CARDS-->

    <HBox spacing="18.0">

        <!-- STUDENTS -->
        <VBox spacing="10.0"
              HBox.hgrow="ALWAYS"
              styleClass="dashboard-card">

            <Label text="ST"
                   styleClass="stat-icon stat-icon-students"/>

            <Label text="Students"
                   styleClass="card-title"/>

            <Label text="0"
                   styleClass="card-value"/>

            <Label text="Total students"
                   styleClass="card-description"/>

        </VBox>


        <!-- CLASSES -->
        <VBox spacing="10.0"
              HBox.hgrow="ALWAYS"
              styleClass="dashboard-card">

            <Label text="CL"
                   styleClass="stat-icon stat-icon-classes"/>

            <Label text="Classes"
                   styleClass="card-title"/>

            <Label text="0"
                   styleClass="card-value"/>

            <Label text="Active classes"
                   styleClass="card-description"/>

        </VBox>


        <!-- SUBJECTS -->
        <VBox spacing="10.0"
              HBox.hgrow="ALWAYS"
              styleClass="dashboard-card">

            <Label text="SB"
                   styleClass="stat-icon stat-icon-subjects"/>

            <Label text="Subjects"
                   styleClass="card-title"/>

            <Label text="0"
                   styleClass="card-value"/>

            <Label text="Available subjects"
                   styleClass="card-description"/>

        </VBox>


        <!-- USERS -->
        <VBox spacing="10.0"
              HBox.hgrow="ALWAYS"
              styleClass="dashboard-card">

            <Label text="US"
                   styleClass="stat-icon stat-icon-users"/>

            <Label text="Users"
                   styleClass="card-title"/>

            <Label text="0"
                   styleClass="card-value"/>

            <Label text="System users"
                   styleClass="card-description"/>

        </VBox>

    </HBox>


    <!--  LOWER CONTENT  -->

    <HBox spacing="18.0"
          VBox.vgrow="ALWAYS">


        <!--  RECENT ACTIVITY  -->

        <VBox spacing="16.0"
              HBox.hgrow="ALWAYS"
              styleClass="dashboard-section">

            <HBox alignment="CENTER_LEFT">

                <Label text="Recent Activity"
                       styleClass="section-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="View all"
                       styleClass="section-link"/>

            </HBox>


            <VBox spacing="4.0"
                  VBox.vgrow="ALWAYS">


                <!-- Activity 1 -->

                <HBox spacing="12.0"
                      alignment="CENTER_LEFT"
                      styleClass="activity-row">

                    <Label text="ST"
                           styleClass="activity-icon activity-icon-blue"/>

                    <VBox spacing="3.0">

                        <Label text="Created student record"
                               styleClass="activity-title"/>

                        <Label text="STU005 • Students"
                               styleClass="activity-description"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="10 min ago"
                           styleClass="activity-time"/>

                </HBox>


                <!-- Activity 2 -->

                <HBox spacing="12.0"
                      alignment="CENTER_LEFT"
                      styleClass="activity-row">

                    <Label text="SB"
                           styleClass="activity-icon activity-icon-orange"/>

                    <VBox spacing="3.0">

                        <Label text="Added Mathematics subject"
                               styleClass="activity-title"/>

                        <Label text="MATH • Subjects"
                               styleClass="activity-description"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="25 min ago"
                           styleClass="activity-time"/>

                </HBox>


                <!-- Activity 3 -->

                <HBox spacing="12.0"
                      alignment="CENTER_LEFT"
                      styleClass="activity-row">

                    <Label text="CL"
                           styleClass="activity-icon activity-icon-green"/>

                    <VBox spacing="3.0">

                        <Label text="Updated Senior One class"
                               styleClass="activity-title"/>

                        <Label text="Senior One • Classes"
                               styleClass="activity-description"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="1 hour ago"
                           styleClass="activity-time"/>

                </HBox>


                <!-- Activity 4 -->

                <HBox spacing="12.0"
                      alignment="CENTER_LEFT"
                      styleClass="activity-row">

                    <Label text="US"
                           styleClass="activity-icon activity-icon-purple"/>

                    <VBox spacing="3.0">

                        <Label text="Created new user"
                               styleClass="activity-title"/>

                        <Label text="Administrator • Users"
                               styleClass="activity-description"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="2 hours ago"
                           styleClass="activity-time"/>

                </HBox>


            </VBox>

        </VBox>


        <!--  QUICK ACTIONS -->

        <VBox spacing="16.0"
              prefWidth="320.0"
              styleClass="dashboard-section">

            <Label text="Quick Actions"
                   styleClass="section-title"/>

            <Button text="+  Add Student"
                    maxWidth="Infinity"
                    styleClass="dashboard-action-button"
                    onAction="#handleAddStudent"/>

            <Button text="+  Add Class"
                    maxWidth="Infinity"
                    styleClass="dashboard-action-button"
                    onAction="#handleAddClass"/>

            <Button text="+  Add Subject"
                    maxWidth="Infinity"
                    styleClass="dashboard-action-button"
                    onAction="#handleAddSubject"/>

        </VBox>


    </HBox>

</VBox>