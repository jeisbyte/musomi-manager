<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           prefWidth="980.0"
           prefHeight="630.0">

    <VBox spacing="25.0"
          styleClass="dashboard-container">

        <!-- PAGE HEADER -->
        <VBox spacing="5.0">

            <Label text="Dashboard"
                   styleClass="page-title"/>

            <Label text="Welcome to Musomi Manager"
                   styleClass="page-subtitle"/>

        </VBox>


        <!-- SUMMARY CARDS -->
        <GridPane hgap="20.0"
                  vgap="20.0">

            <!-- STUDENTS -->
            <VBox GridPane.columnIndex="0"
                  spacing="8.0"
                  prefWidth="210.0"
                  prefHeight="130.0"
                  styleClass="dashboard-card">

                <Label text="Students"
                       styleClass="card-title"/>

                <Label text="0"
                       styleClass="card-value"/>

                <Label text="Total students"
                       styleClass="card-description"/>

            </VBox>


            <!-- CLASSES -->
            <VBox GridPane.columnIndex="1"
                  spacing="8.0"
                  prefWidth="210.0"
                  prefHeight="130.0"
                  styleClass="dashboard-card">

                <Label text="Classes"
                       styleClass="card-title"/>

                <Label text="0"
                       styleClass="card-value"/>

                <Label text="Active classes"
                       styleClass="card-description"/>

            </VBox>


            <!-- SUBJECTS -->
            <VBox GridPane.columnIndex="2"
                  spacing="8.0"
                  prefWidth="210.0"
                  prefHeight="130.0"
                  styleClass="dashboard-card">

                <Label text="Subjects"
                       styleClass="card-title"/>

                <Label text="0"
                       styleClass="card-value"/>

                <Label text="Available subjects"
                       styleClass="card-description"/>

            </VBox>


            <!-- USERS -->
            <VBox GridPane.columnIndex="3"
                  spacing="8.0"
                  prefWidth="210.0"
                  prefHeight="130.0"
                  styleClass="dashboard-card">

                <Label text="Users"
                       styleClass="card-title"/>

                <Label text="0"
                       styleClass="card-value"/>

                <Label text="System users"
                       styleClass="card-description"/>

            </VBox>

        </GridPane>


        <!-- LOWER DASHBOARD SECTION -->
        <HBox spacing="20.0">

            <!-- RECENT ACTIVITY -->
            <VBox spacing="12.0"
                  prefWidth="500.0"
                  prefHeight="220.0"
                  styleClass="dashboard-card">

                <Label text="Recent Activity"
                       styleClass="section-title"/>

                <Label text="No recent activity"
                       styleClass="card-description"/>

                <Label text="Activity will appear here when users perform actions."
                       styleClass="card-description"/>

            </VBox>


            <!-- QUICK ACTIONS -->
            <VBox spacing="12.0"
                  prefWidth="300.0"
                  prefHeight="220.0"
                  styleClass="dashboard-card">

                <Label text="Quick Actions"
                       styleClass="section-title"/>

                <Button text="+ Add Student"
                        maxWidth="Infinity"/>

                <Button text="+ Add Class"
                        maxWidth="Infinity"/>

                <Button text="+ Add Subject"
                        maxWidth="Infinity"/>

            </VBox>

        </HBox>

    </VBox>

</StackPane>